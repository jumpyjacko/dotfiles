(defpoll workspaces :interval "0.2s" "niri msg -j workspaces | jq 'sort_by(.id)'")

(defwidget workspaces []
    (box :class "workspaces"
         :orientation "vertical"
         :space-evenly false
         :spacing "3"
         :valign "end"
        (for ws in workspaces
            (button :onclick "niri msg action focus-workspace ${ws.id}" 
                (label :class "workspace"
                       :text {
                    ws.is_focused == true ? "" : ""
                })
            )
        )
    )
)
