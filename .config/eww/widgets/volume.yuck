(deflisten volume "$HOME/.config/eww/scripts/volume")

(defwidget h_volume []
    (box :vexpand false
         :hexpand false
        (label :text {volume.muted == "yes" ? " " : "  ${volume.volume}%"})
    )
)

(defvar vol_hover false)
(defwidget v_volume []
    (eventbox :onhover "${eww} update vol_hover=true"
              :onhoverlost "${eww} update vol_hover=false"
        (box :orientation "vertical"
             :space-evenly false
             :spacing "5"
             :tooltip "Volume: ${volume.volume}%"
            (revealer :transition "slideup"
                      :reveal vol_hover
                      :duration "200ms"
                (scale :class "v-slider"
                       :value {volume.volume} 
                       :orientation "vertical"
                       :flipped true
                       :max 101
                       :min 0
                       :onchange "amixer -D pulse sset Master {}%"
                )
            )
            (button :onclick "pamixer --toggle-mute"
                    :valign "end"
                (label :text {volume.muted == "yes" ? "" :
                    volume.volume > 40 ? "" : ""}
                )
            )
        )
    )
)
