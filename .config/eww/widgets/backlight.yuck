(defpoll backlight :interval "1s" "$HOME/.config/eww/scripts/backlight")

(defwidget h_backlight []
  (box :vexpand false
       :hexpand false
    (label :text " ${backlight.percent}%")
  )
)

(defvar backlight_hover false)
(defwidget v_backlight []
    (eventbox :onhover "${eww} update backlight_hover=true"
              :onhoverlost "${eww} update backlight_hover=false"
              :onscroll "$HOME/.config/eww/scripts/backlight-scroll {}"
        (box :orientation "vertical"
             :space-evenly false
             :spacing "5"
             :tooltip "Brightness: ${backlight.percent}%"
            (revealer :transition "slideup"
                      :reveal backlight_hover
                      :duration "200ms"
                (scale :class "v-slider"
                       :value {backlight.percent} 
                       :orientation "vertical"
                       :flipped true
                       :max 101
                       :min 0
                       :onchange "brightnessctl set {}%"
                )
            )
            (button :onclick "niri msg action power-off-monitors"
                (label :text "󰌵")
            )
        )
    )
)

