{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "color": {
            "1": "blue",
            "2": "blue"
        }
    },
    "display": {
        "color": {
            "keys": "blue" ,
            "title": "blue",
            "separator": "blue"
        },
        "key": {
            "width": 17
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        {
            "type": "host",
            "format": "{/2}{-}{/}{2}{?3} {3}{?}"
        },
        "uptime",
        "break",
        "packages",
        "shell",
        "terminal",
        "wm",
        "break",
        "cpu",
        {
            "type": "gpu",
            "key": "GPU"
        },
        "memory",
        {
            "type": "battery",
            "key": "Battery",
            "format": "{/4}{-}{/}{4}{?5} [{5}]{?}"
        },
        {
            "type": "command",
            "key": "Bat. Remaining",
            "text": "upower -i $(upower -e | grep BAT) | grep -E 'time to empty' | awk -F':' '{print $2}' | xargs"
        },
        {
            "type": "command",
            "key": "Bat. Capacity",
            "text": "upower -i $(upower -e | grep BAT) | grep -E 'energy-full|capacity' | awk -F' ' 'NR==1 { a = $(NF-1) } NR==2 { b = $(NF-1) } NR==3 { c = $(NF) } END { print a \" / \" b \" Wh \" \"[\" c \"]\" }' | xargs"
        },
        {
            "type": "display",
            "key": "Display"
        },
        "break",
        "colors"
    ]
}
